# Modelo provisional: cambiar también el prefijo si se elige otro modelo.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_PASSAGE_PREFIX="passage: "
# Opcional: si el tokenizer no declara un límite, indicar el del modelo.
# EMBEDDING_MAX_TOKENS=512

# Configuración inicial V1; otras parejas siguen disponibles para experimentos.
CHUNK_SIZE_TOKENS=256
CHUNK_OVERLAP_TOKENS=32

# Chroma persistente; top_k y threshold se configuran en get_retriever.
# CHROMA_DIR="D:/chroma_db/corpus_runs/6234072f9e49416da062e959e358827b"
# CHROMA_COLLECTION="corpus_256_32"

# --- Autenticación (Chainlit nativa, Google OAuth) — solo nombres, nunca valores ---
# Generar el secreto de sesión:  chainlit create-secret
# Client ID/secret: Google Cloud Console → APIs y servicios → Credenciales
#   → OAuth client ID (tipo «Web»).
# Redirect URI registrado: http://localhost:8000/auth/oauth/google/callback
# Sin estas variables la app arranca igual: el login queda desactivado.
CHAINLIT_AUTH_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# --- Persistencia de conversaciones (SQLite local) ---
# Activada por defecto; hilos y pasos se guardan por usuario de sesión.
# CHAINLIT_PERSISTENCE=0
# CHAINLIT_SQLITE_PATH=./ui/.data/chainlit.db

# ==============================================================================
# LLM Configuration (RAG Engine)
# ==============================================================================

LLM_PROVIDER=openai

# Usamos Groq con compatibilidad OpenAI (100% gratuito)
GROQ_API_KEY="tu clave de API aquí"
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_BASE=https://api.groq.com/openai/v1
